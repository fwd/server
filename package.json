{
  "name": "@fwd/server",
  "version": "1.1.8",
  "description": "NodeJS Full-Stack Framework",
  "main": "index.js",
  "author": "Fresh Web Designs <hello@fwd.dev>",
  "license": "MIT",
  "homepage": "https://github.com/fwd/server",
  "repository": {
    "type": "git",
    "url": "git@github.com:fwd/server.git"
  },
  "bugs": {
    "url": "https://github.com/fwd/server/issues"
  },
  "dependencies": {
    "@fwd/database": "1.1.1",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.17.1",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.27"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./__tests__/setup.js"
    ],
    "collectCoverageFrom": [
      "index.js",
      "!node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  }
}
